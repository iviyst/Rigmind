{
  "name": "rigmind",
  "productName": "Rigmind",
  "version": "1.2.0",
  "description": "AI-powered monitoring, Game Boost and driver updates for a Windows gaming PC",
  "main": "dist-electron/main/main.js",
  "author": "Chris",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "concurrently -k -n vite,electron \"vite\" \"npm:dev:electron\"",
    "dev:electron": "wait-on tcp:5173 && tsc -p tsconfig.node.json && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "preview:ui": "vite",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.node.json && vite build",
    "dist": "npm run build && electron-builder --win --publish never",
    "build:hw": "dotnet publish hw/RigmindHw.csproj -c Release -o resources/rigmind-hw",
    "release": "npm run build && electron-builder --win --publish always"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "latest",
    "electron-updater": "^6.8.11",
    "openrgb-sdk": "^0.6.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@fontsource/barlow": "latest",
    "@fontsource/chakra-petch": "latest",
    "@types/node": "^26",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "latest",
    "concurrently": "latest",
    "cross-env": "latest",
    "electron": "latest",
    "electron-builder": "latest",
    "react": "^19",
    "react-dom": "^19",
    "typescript": "^5",
    "vite": "latest",
    "wait-on": "latest"
  }
}
